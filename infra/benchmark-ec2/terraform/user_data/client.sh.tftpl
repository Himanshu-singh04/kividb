#!/bin/bash
# Benchmark client (c7gn.16xlarge class): memtier_benchmark from source + Rust
# (needed to build KiviDB from source in CI) + optional GitHub Actions
# self-hosted runner self-registration.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

exec > >(tee /var/log/user-data-client.log) 2>&1

apt-get update -y
apt-get install -y build-essential autoconf automake libpcre3-dev \
  libevent-dev pkg-config zlib1g-dev libssl-dev git curl jq

# Same rationale as the server: run flat-out instead of ramping up from idle.
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  if [[ -w "$gov" ]]; then echo performance > "$gov" || true; fi
done

sudo -u ubuntu -H bash << 'EOSU'
set -euo pipefail
cd /home/ubuntu

if [[ ! -x "$HOME/.cargo/bin/cargo" ]]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
fi

if [[ ! -d /home/ubuntu/memtier_benchmark ]]; then
  git clone https://github.com/RedisLabs/memtier_benchmark
fi
cd /home/ubuntu/memtier_benchmark
git pull --ff-only || true
autoreconf -ivf
./configure
make -j"$(nproc)"
EOSU

cd /home/ubuntu/memtier_benchmark && make install
echo "memtier_benchmark: $(command -v memtier_benchmark)"

%{ if register_github_runner }
# ── GitHub Actions self-hosted runner ────────────────────────────────────────
# --ephemeral: the runner accepts exactly one job, then deregisters itself
# and exits. That is what lets the destroy step simply terminate the
# instance without a separate "remove runner" API call in the normal path.
#
# GitHub refuses registration from a runner older than a minimum it raises
# every few months ("Your runner version is out of date and can no longer
# register"), so a version written down here goes stale: the instance boots,
# the registration fails, and the job that was to run on it waits in the
# queue. "latest" asks GitHub which release is current — from the redirect of
# the releases page, which takes no API token and has no rate limit.
RUNNER_VERSION="${runner_version}"
if [[ "$RUNNER_VERSION" == "latest" ]]; then
  RUNNER_VERSION="$(curl -fsS --retry 5 --retry-delay 3 -o /dev/null -w '%%{redirect_url}' \
    https://github.com/actions/runner/releases/latest | sed 's#.*/tag/v##')"
fi
if [[ ! "$RUNNER_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "ERROR: could not tell which actions/runner release to install (got '$RUNNER_VERSION')."
  exit 1
fi
echo "Installing actions/runner $RUNNER_VERSION"
RUNNER_DIR=/home/ubuntu/actions-runner
mkdir -p "$RUNNER_DIR"
chown ubuntu:ubuntu "$RUNNER_DIR"

sudo -u ubuntu -H bash << EOSU2
set -euo pipefail
cd "$RUNNER_DIR"
curl -fsSL --retry 5 --retry-delay 3 -o actions-runner.tar.gz \
  "https://github.com/actions/runner/releases/download/v$RUNNER_VERSION/actions-runner-linux-arm64-$RUNNER_VERSION.tar.gz"
tar xzf actions-runner.tar.gz
rm -f actions-runner.tar.gz

./config.sh --unattended \
  --url "https://github.com/${github_repository}" \
  --token "${registration_token}" \
  --name "${runner_name}" \
  --labels "${runner_labels}" \
  --work _work \
  --ephemeral

nohup ./run.sh > /home/ubuntu/actions-runner.log 2>&1 &
disown
EOSU2

echo "GitHub Actions runner configured and started (ephemeral, labels: ${runner_labels})."
%{ endif }

echo "Client user-data finished."
