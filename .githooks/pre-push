#!/usr/bin/env bash
# Clippy as CI runs it (-D warnings, without features and with lua,tls), on
# this machine's OS and on Linux in Docker. Each OS compiles code the other
# does not: the io_uring path is Linux-only, and Windows has its own cfgs. A
# warm run takes a minute or two.
#
# Runs only when the commits being pushed touch Rust code or Cargo files.
# Without Docker, the Linux half is skipped with a warning rather than
# blocking the push. Skip it all with `git push --no-verify` or
# KIVIDB_SKIP_HOOKS=1.
#
# Before merging, run the whole gate: scripts/ci-local.sh full

[ "${KIVIDB_SKIP_HOOKS:-0}" = 1 ] && exit 0
ZERO=0000000000000000000000000000000000000000

changed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a branch
  if [ "$remote_sha" = "$ZERO" ]; then
    # A new branch: compare with where it left master.
    base=$(git merge-base "$local_sha" origin/master 2>/dev/null) || base=""
  else
    base=$remote_sha
  fi
  files=$( [ -n "$base" ] && git diff --name-only "$base" "$local_sha" || git show --name-only --format= "$local_sha")
  if echo "$files" | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|^rust-toolchain'; then
    changed=1
  fi
done
[ $changed = 1 ] || exit 0

fail=0
echo "pre-push: clippy on $(uname -s) (without features, then lua,tls)..."
cargo clippy --quiet --all-targets -- -D warnings || fail=1
cargo clippy --quiet --all-targets --features lua,tls -- -D warnings || fail=1

if docker info >/dev/null 2>&1; then
  echo "pre-push: fmt and clippy on Linux (Docker)..."
  bash scripts/ci-local.sh quick || fail=1
else
  echo "pre-push: WARNING: Docker is not running, so the Linux checks were skipped." >&2
  echo "          The io_uring path was not linted. Run scripts/ci-local.sh quick later." >&2
fi

if [ $fail = 1 ]; then
  echo "pre-push: checks failed; nothing was pushed. (git push --no-verify skips them.)" >&2
  exit 1
fi
